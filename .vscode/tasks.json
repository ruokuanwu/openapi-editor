// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "watch:webview",
			"type": "shell",
			"command": "pnpm run watch",
			"options": {
				"cwd": "${workspaceFolder}/webview-ui"
			},
			"isBackground": true,
			"problemMatcher": [
				{
					"owner": "vite",
					"pattern": {
						"regexp": "^$"
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": "build started",
						"endsPattern": "built in"
					}
				}
			],
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated"
			}
		},
		{
			"label": "watch:all",
			"dependsOn": [
				"npm: watch",
				"watch:webview"
			],
			"dependsOrder": "parallel",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}