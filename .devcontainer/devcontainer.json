{
    "build": {
        "dockerfile": "Dockerfile",
        "options": [
            "--network=host"
        ]
    },
    "remoteUser": "root",
    "runArgs": [
        "--user",
        "root"
    ],
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
        // // 挂载本地 .ssh 目录到容器的 /root/.ssh（root 用户）
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,consistency=cached"
        // 如果容器使用非 root 用户（比如 vscode），需要额外挂载到对应目录
        // "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    ],
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1.8.0": {
            "moby": false,
            "dockerDashComposeVersion": "v2.32.3"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "adam-bender.commit-message-editor",
                "johnny-zhao.oai-compatible-copilot",
                "mhutchie.git-graph",
                "cpulvermacher.lgtm",
                "oderwat.indent-rainbow",
                "actboy168.tasks",
                "redhat.vscode-yaml",
                "YuTengjing.vscode-archive",
                "eamodio.gitlens",
                "Vue.volar"
            ],
            "settings": {
                "extensions.verifySignature": false
            }
        }
    },
    "containerEnv": {},
    "forwardPorts": [
        3001
    ]
    // "postStartCommand": "bash .devcontainer/post-start-command.sh"
}