{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "out",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": ".",
		"strict": true,
		"noEmit": false,
		"declaration": false
	},
	"include": [
		"src/**/*",
		"shared/**/*"
	],
	"exclude": [
		"webview-ui",
		"node_modules",
		"out"
	]
}